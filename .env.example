# Valeurs privees de l'administrateur. Ce fichier exemple ne contient aucun secret.
# Copiez-le en .env ; ce dernier est ignore par Git et charge par npm start.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facultatif sur Codespaces et Render : detection automatique de l'adresse HTTPS.
PUBLIC_ORIGIN=
# Laissez l'hote vide pour la detection locale/Codespaces/Render.
FEED_STUDIO_HOST=
FEED_STUDIO_PORT=3000
