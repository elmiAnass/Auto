# Administrator setup only. Put real values in secure environment settings or
# an ignored .env file. Never commit credentials.
# Optional on Render and Codespaces: the hosting origin is detected automatically.
PUBLIC_ORIGIN=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: enables photo-aware English captions through the server.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Defaults for development; an HTTPS reverse proxy is needed for public hosting.
FEED_STUDIO_HOST=127.0.0.1
FEED_STUDIO_PORT=3000
