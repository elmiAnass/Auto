{
  "name": "canva-feed-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Private Canva photo planning in Google Sheets and Google Docs",
  "engines": {
    "node": ">=24.5.0"
  },
  "scripts": {
    "prestart": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env --use-env-proxy server/server.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "test:browser": "python3 tests/browser_smoke.py"
  }
}
